# =========================================================
# CadorDigital Frontend — Environment Template
# Copy to `.env.local` (local dev) or set these in Vercel.
# =========================================================

# API URL for the backend. Production backend runs on Render.
NEXT_PUBLIC_API_URL=https://cado-backend.onrender.com/api

# Cloudinary — REQUIRED in production so uploaded images/videos display.
# Set to the same cloud name configured on the backend (Render).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Google Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Public site URL (used for canonical/OG tags). Defaults to https://cador.digital
NEXT_PUBLIC_SITE_URL=https://cador.digital
