# API URL for the backend (use 127.0.0.1 to avoid IPv6 issues)
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000/api

# Cloudinary (optional – keep as empty string if not using)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Google Analytics (optional – keep as empty string if not using)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
